      <div className="grid gap-4 md:grid-cols-3">
        <Card>
          <p className="text-sm text-slate-400">Cuentas abiertas</p>
          <p className="mt-2 text-3xl font-semibold text-cyan-300">{resumen.abiertas}</p>
        </Card>
        <Card>
          <p className="text-sm text-slate-400">Cuentas cerradas</p>
          <p className="mt-2 text-3xl font-semibold text-emerald-300">{resumen.cerradas}</p>
        </Card>
        <Card>
          <p className="text-sm text-slate-400">Facturación acumulada</p>
          <p className="mt-2 text-3xl font-semibold text-white">${resumen.total.toFixed(2)}</p>
        </Card>
      </div>

      <Card>
        <Table
          columns={[
            {
              key: "mesa",
              title: "Mesa",
              render: (row) => (
