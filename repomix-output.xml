    () => ({
      abiertas: cuentas.filter((item) => item.estado === "abierta").length,
      cerradas: cuentas.filter((item) => item.estado === "cerrada").length,
      total: cuentas.reduce((acc, item) => acc + Number(item.total || 0), 0),
    }),
