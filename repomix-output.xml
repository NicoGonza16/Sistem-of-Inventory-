  const closeCuenta = async (cuenta) => {
    await execute(
      async () => {
        await updateCuenta(cuenta.id_cuenta, { estado: "cerrada" });
        await loadCuentas();
      },
      { successMessage: "Cuenta cerrada." }
    );
