  const removeCuenta = async () => {
    if (!confirmState.cuenta) return;

    await execute(
      async () => {
        await deleteCuenta(confirmState.cuenta.id_cuenta);
        await loadCuentas();
        setConfirmState({ open: false, cuenta: null });
      },
      { successMessage: "Cuenta eliminada." }
    );
  };

  if (loadingPage) return <Loader label="Cargando cuentas..." />;

  return (
